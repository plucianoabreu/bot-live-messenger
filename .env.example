NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://127.0.0.1:3000
# Keep false until worker integration and release gates pass.
RUNS_ENABLED=false
# Text-chat worker configuration; never expose these through NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
TRIGGER_SECRET_KEY=
TRIGGER_PRODUCTION_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
# Verified model-specific USD micros per token, required before calls.
OPENAI_INPUT_MICROS_PER_TOKEN=
OPENAI_OUTPUT_MICROS_PER_TOKEN=
# Keep false until the collaboration migration and owner-isolation checks pass.
MEMORY_ENABLED=false

# Hermes: enable together on the web gateway and Trigger worker after provisioning.
HERMES_ENABLED=false
HERMES_TEMPLATE_ID=
HERMES_MODEL_GATEWAY_URL=https://www.botlivemessenger.com/api/hermes/v1

# Computer worker configuration. Keep computer tools unavailable until verified.
E2B_API_KEY=
E2B_TEMPLATE_ID=
# Computer routes also require every verification flag and policy value below.
COMPUTER_ENABLED=false
E2B_TEMPLATE_VERIFIED=false
E2B_TEMPLATE_VERSION=
E2B_NETWORK_POLICY_VERSION=
# Exact comma-separated HTTPS hostnames (no IPs or wildcards). Hermes requires
# this list to include the hostname from HERMES_MODEL_GATEWAY_URL.
E2B_ALLOWED_HOSTS=
ARTIFACT_BUCKET=bot-messenger-artifacts
WATCH_FRAME_BUCKET=bot-messenger-watch-frames

# Account deletion is unavailable until a deployed cleanup worker and its
# idempotent computer destroyer have been verified by the operator.
ACCOUNT_CLEANUP_ENABLED=false
ACCOUNT_CLEANUP_WORKER_CONFIGURED=false
ACCOUNT_CLEANUP_COMPUTER_DESTROYER_CONFIGURED=false
